{
  "name": "@innersun/db",
  "version": "0.1.0",
  "private": true,
  "description": "InnerSun database: local PostgreSQL + pgvector, migrations, and seeds.",
  "type": "module",
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "down:clean": "docker compose down -v",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reembed": "tsx scripts/reembed.ts",
    "export:patterns": "tsx scripts/export-patterns.ts",
    "pull:patterns": "tsx scripts/pull-patterns.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^7.4.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
