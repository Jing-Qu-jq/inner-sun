# InnerSun environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# For V1 everything runs on localhost.

# ---- API server ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Origin allowed to call the API (the web app during local dev)
WEB_ORIGIN=http://localhost:3000

# Whether this instance serves POST /chat. On by default. Set to false on the hosted
# admin instance (Feature 17), whose only job is letting researchers author Care Patterns
# — an open, unauthenticated, token-spending chat endpoint on the public internet is the
# one thing that deployment must not create. With it off the service cannot run up an
# OpenAI bill: its sole upstream call is one embedding when someone presses Save.
# ENABLE_CHAT_ROUTES=true

# ---- Web app (Feature 5) ----
# Where the browser sends chat messages. It defaults to http://localhost:3001,
# so local development needs nothing set here; Feature 21 points it at the
# deployed API. NOTE: Create React App only reads REACT_APP_* variables from
# apps/web/.env or the shell environment — NOT from this root file. It is listed
# here so every knob is documented in one place.
# REACT_APP_API_BASE_URL=http://localhost:3001

# ---- OpenAI (server-side only — never exposed to the browser) ----
# Used from Feature 4 onward. The key must live ONLY here, never in apps/web.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_REPLY=gpt-4o
OPENAI_MODEL_UTILITY=gpt-4o-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
# Override the OpenAI endpoint. Unset in normal use. Point it at an Azure/OpenAI-compatible
# gateway, or at a local stub to exercise the orchestrator without spending tokens — also
# how the "saved but not indexed" path is tested (aim it at a dead port).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Cap on reply length and how long to wait for OpenAI before giving up.
OPENAI_MAX_REPLY_TOKENS=600
OPENAI_TIMEOUT_MS=30000

# ---- Admin tool (Feature 17) ----
# Whether to serve POST /chat. On by default, because that endpoint is the product.
# Set to false on the HOSTED ADMIN instance, whose only job is letting researchers author
# Care Patterns: an open, unauthenticated, token-spending chat endpoint on the public
# internet is the one thing that deployment must not create. With it off, that service
# cannot run up an OpenAI bill — its sole upstream call is one embedding per save.
# Feature 21 turns it back on behind the abuse protection Feature 20 adds.
# ENABLE_CHAT_ROUTES=true
#
# Admin sessions need no secret: they are rows in `admin_sessions` keyed by the SHA-256 of
# a random cookie token, not a signed stateless cookie. Nothing to configure here.

# ---- Database: PostgreSQL + pgvector (added in Feature 3) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innersun

# The hosted database that holds the researcher-authored Care Patterns (Feature 17).
# Deliberately a SEPARATE variable from DATABASE_URL: the destructive scripts
# (`db:reset`, `db:seed`) read DATABASE_URL and refuse to run unless it points at
# localhost, so reaching production must never mean repointing that variable.
# Used only by `npm run db:pull:patterns` and `npm run db:export:patterns -- --remote`.
# REMOTE_DATABASE_URL=postgresql://user:password@db.example.supabase.co:5432/postgres

# TLS is enabled automatically for any non-local database host and the server's certificate
# IS verified. Setting this disables that verification — the connection stays encrypted but
# becomes vulnerable to anyone on the network path. It exists for a provider using a private
# CA. It is NOT the right answer to a certificate error you have not read; Supabase presents
# a publicly trusted certificate and needs nothing here.
# DATABASE_SSL_NO_VERIFY=true
